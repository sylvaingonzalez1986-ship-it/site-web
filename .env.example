# Viva Smart Checkout (OAuth2, recommende)
# VIVA_ENV=demo ou production
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
# Required for /api/checkout/viva/webhook security
VIVA_WEBHOOK_TOKEN=

# Legacy (non utilise pour le checkout actuel, garde pour reference)
VIVA_MERCHANT_ID=
VIVA_API_KEY=

# Admin access
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Public site URL for canonical links and JSON-LD
NEXT_PUBLIC_SITE_URL=https://leschanvriersbretons.com
# Optional phone used in LocalBusiness/Organization JSON-LD
BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE=
# Tutorial overlay global switch
NEXT_PUBLIC_TUTORIAL_ENABLED=true
# CMS pages global switches
CMS_PAGES_ENABLED=true
NEXT_PUBLIC_CMS_PAGES_ENABLED=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Password leak protection via HaveIBeenPwned k-anonymity API
# PASSWORD_LEAK_CHECK_MODE=off|monitor|enforce
# Default: enforce in production, monitor in development
PASSWORD_LEAK_CHECK_MODE=enforce
# Referral rewards points
REFERRAL_REWARD_REFERRER_POINTS=120
REFERRAL_REWARD_REFEREE_POINTS=80

# Newsletter e-mail confirmation (SMTP)
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_SMTP_SECURE=false
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=Les Chanvriers Bretons
NEWSLETTER_REPLY_TO=leschanvriersbretons@gmail.com
CONTACT_RECEIVER_EMAIL=leschanvriersbretons@gmail.com

# Invoice rendering
# INVOICE_VAT_MODE=exempt|taxable
INVOICE_VAT_MODE=taxable

# Shipping pricing
SHIPPING_HOME_FEE_EUR=6.90
SHIPPING_RELAY_FEE_EUR=4.90
SHIPPING_FREE_THRESHOLD_EUR=69
NEXT_PUBLIC_SHIPPING_HOME_FEE_EUR=6.90
NEXT_PUBLIC_SHIPPING_RELAY_FEE_EUR=4.90
NEXT_PUBLIC_SHIPPING_FREE_THRESHOLD_EUR=69

# Mondial Relay
# MONDIAL_RELAY_ENV=test|production
MONDIAL_RELAY_ENV=test

# API 1 (WebService SOAP)
MONDIAL_RELAY_API1_URL=https://api.mondialrelay.com/WebService.asmx
MONDIAL_RELAY_API1_ENSEIGNE=
MONDIAL_RELAY_API1_PRIVATE_KEY=
# Widget Point Relais: utiliser le code client/enseigne (ex: CC23JMDW en prod, TTMRSDBX en test)
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=

# API 2 (Connect REST)
MONDIAL_RELAY_API2_URL=
MONDIAL_RELAY_API2_BRAND_ID=
MONDIAL_RELAY_API2_USERNAME=
MONDIAL_RELAY_API2_PASSWORD=

# Sender / warehouse defaults for label creation
MONDIAL_RELAY_SENDER_NAME=
MONDIAL_RELAY_SENDER_ADDRESS1=8 rue du 8 mai 1945
MONDIAL_RELAY_SENDER_ADDRESS2=
MONDIAL_RELAY_SENDER_POSTAL_CODE=35340
MONDIAL_RELAY_SENDER_CITY=La Bouexiere
MONDIAL_RELAY_SENDER_COUNTRY=FR
MONDIAL_RELAY_SENDER_PHONE=
MONDIAL_RELAY_SENDER_EMAIL=

# Default parcel profile
MONDIAL_RELAY_DEFAULT_WEIGHT_G=500
MONDIAL_RELAY_DEFAULT_LENGTH_CM=20
MONDIAL_RELAY_DEFAULT_WIDTH_CM=15
MONDIAL_RELAY_DEFAULT_HEIGHT_CM=10
