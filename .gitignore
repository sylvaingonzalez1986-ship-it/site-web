# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime product uploads
public/uploads/products/*
!public/uploads/products/.gitkeep
public/uploads/blog/*
!public/uploads/blog/.gitkeep
public/uploads/producers/*
!public/uploads/producers/.gitkeep

# local runtime data (never commit customer/order/invoice exports)
data/*.json

# local supabase cli temp files
supabase/.temp/

# local scratch files
tmp*
tmp/
tmp_supabase_push/
/output/placard-mobile-audits/
/output/placard-mobile-manual-reviews/
/output/placard-load-tests/
/output/placard-smoke-tests/
/output/placard-artwork-reviews/
/output/placard-retro-evidence/
/output/placard-launch-evidence/
/output/placard-rehearsal-build/
/output/placard-rehearsal-tools/
/output/arena-retro/
/output/tasting-book/
/output/placard-workshop/
/output/site-css-check/
/output/seo-audit/
/output/next-dev-css-cache-backup/
/output/reputation-test-tools/
.env*.local
.next-dev*.log
