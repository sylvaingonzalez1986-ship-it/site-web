# Viva Smart Checkout (OAuth2, recommende)
# VIVA_ENV=demo ou production
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
# Required for /api/checkout/viva/webhook security
VIVA_WEBHOOK_TOKEN=

# Legacy (non utilise pour le checkout actuel, garde pour reference)
VIVA_MERCHANT_ID=
VIVA_API_KEY=

# Admin access
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Comma-separated list of emails allowed to log in as admin
# Falls back to leschanvriersbretons@gmail.com if empty/missing
ADMIN_ALLOWED_EMAILS=

# Public site URL for canonical links and JSON-LD
NEXT_PUBLIC_SITE_URL=https://leschanvriersbretons.com
# IndexNow ownership key (8-128 letters, digits or hyphens). The matching
# validation file is served automatically at /indexnow-key.txt.
INDEXNOW_KEY=
# Optional phone used in LocalBusiness/Organization JSON-LD
BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_PHONE=
# Tutorial overlay global switch
NEXT_PUBLIC_TUTORIAL_ENABLED=true
# CMS pages global switches
CMS_PAGES_ENABLED=true
NEXT_PUBLIC_CMS_PAGES_ENABLED=true

# Contest beta gate
# Set all three to true in production to keep Bete de concours private:
# admin emails always pass, selected customers pass when enabled in Admin > Clients.
CONTEST_FEATURE_ENABLED=false
CONTEST_FEATURE_ALLOW_PRODUCTION=false
CONTEST_BETA_ACCESS_ENABLED=false
NEXT_PUBLIC_CONTEST_FEATURE_ENABLED=false
NEXT_PUBLIC_CONTEST_FEATURE_ALLOW_PRODUCTION=false
NEXT_PUBLIC_CONTEST_BETA_ACCESS_ENABLED=false
# Storefront tasting notes and reviews are opt-in while the feature is paused.
PRODUCT_TASTING_STOREFRONT_ENABLED=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
# Use NEXT_PUBLIC_SENTRY_DSN for browser events, SENTRY_DSN also works server-side.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Password leak protection via HaveIBeenPwned k-anonymity API
# PASSWORD_LEAK_CHECK_MODE=off|monitor|enforce
# Default: enforce in production, monitor in development
PASSWORD_LEAK_CHECK_MODE=enforce
# Referral rewards points
REFERRAL_REWARD_REFERRER_POINTS=120
REFERRAL_REWARD_REFEREE_POINTS=80

# Newsletter e-mail confirmation (SMTP)
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=587
NEWSLETTER_SMTP_SECURE=false
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=Les Chanvriers Bretons
NEWSLETTER_REPLY_TO=leschanvriersbretons@gmail.com
CONTACT_RECEIVER_EMAIL=leschanvriersbretons@gmail.com

# Invoice rendering
# INVOICE_VAT_MODE=exempt|taxable
INVOICE_VAT_MODE=taxable

# Shipping pricing
SHIPPING_HOME_FEE_EUR=6.90
SHIPPING_RELAY_FEE_EUR=4.90
SHIPPING_FREE_THRESHOLD_EUR=89
NEXT_PUBLIC_SHIPPING_HOME_FEE_EUR=6.90
NEXT_PUBLIC_SHIPPING_RELAY_FEE_EUR=4.90
NEXT_PUBLIC_SHIPPING_FREE_THRESHOLD_EUR=89

# Colissimo (disabled until both flags and credentials are configured)
COLISSIMO_ENABLED=false
NEXT_PUBLIC_COLISSIMO_ENABLED=false
COLISSIMO_API_KEY=
# Optional partner/delegated access code supplied by Colissimo
COLISSIMO_PARTNER_CODE=
COLISSIMO_PICKUP_API_URL=https://ws.colissimo.fr/pointretrait-ws-cxf/rest/v2/pointretrait/findRDVPointRetraitAcheminement
COLISSIMO_DEFAULT_WEIGHT_G=500

# Mondial Relay
# MONDIAL_RELAY_ENV=test|production
MONDIAL_RELAY_ENV=test

# Mondial Relay CSV export defaults (collection settings)
# MONDIAL_RELAY_COLLECTION_TYPE=R|D
MONDIAL_RELAY_COLLECTION_TYPE=R
MONDIAL_RELAY_COLLECTION_RELAY_ID=
MONDIAL_RELAY_COLLECTION_COUNTRY=FR

# API 1 (WebService SOAP)
MONDIAL_RELAY_API1_URL=https://api.mondialrelay.com/WebService.asmx
MONDIAL_RELAY_API1_ENSEIGNE=
MONDIAL_RELAY_API1_PRIVATE_KEY=
# Widget Point Relais: utiliser le code client/enseigne (ex: CC23JMDW en prod, TTMRSDBX en test)
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=

# API 2 (Connect REST)
MONDIAL_RELAY_API2_URL=
MONDIAL_RELAY_API2_BRAND_ID=
MONDIAL_RELAY_API2_USERNAME=
MONDIAL_RELAY_API2_PASSWORD=

# Sender / warehouse defaults for label creation
MONDIAL_RELAY_SENDER_NAME=
MONDIAL_RELAY_SENDER_ADDRESS1=8 rue du 8 mai 1945
MONDIAL_RELAY_SENDER_ADDRESS2=
MONDIAL_RELAY_SENDER_POSTAL_CODE=35340
MONDIAL_RELAY_SENDER_CITY=La Bouexiere
MONDIAL_RELAY_SENDER_COUNTRY=FR
MONDIAL_RELAY_SENDER_PHONE=
MONDIAL_RELAY_SENDER_EMAIL=

# Default parcel profile
MONDIAL_RELAY_DEFAULT_WEIGHT_G=500
MONDIAL_RELAY_DEFAULT_LENGTH_CM=20
MONDIAL_RELAY_DEFAULT_WIDTH_CM=15
MONDIAL_RELAY_DEFAULT_HEIGHT_CM=10

# Kanab Quest — must stay false until the coordinated customer launch.
KQ_PLAYER_API_LIVE=false
# À basculer uniquement après validation du règlement, des lots, des dates,
# du territoire et des probabilités Héritage.
KQ_PUBLIC_RULES_APPROVED=false

# Test de charge Placard en lecture seule (local/recette uniquement).
# PLACARD_LOAD_TEST_BASE_URL=http://127.0.0.1:3000
# PLACARD_LOAD_TEST_COOKIE=nom_session=valeur_du_compte_de_recette
# PLACARD_LOAD_TEST_PARTICIPANTS=25
# PLACARD_LOAD_TEST_RAMP_MS=15000
# PLACARD_LOAD_TEST_TIMEOUT_MS=10000
# PLACARD_LOAD_TEST_PAGE_P95_MS=2500
# PLACARD_LOAD_TEST_API_P95_MS=1200
# PLACARD_LOAD_TEST_MAX_ERROR_RATE=0.01
# PLACARD_LOAD_TEST_ALLOW_REMOTE=0

# Smoke test transactionnel Placard, exclusivement sur localhost.
# Une carte ou deux Fleurs seront réellement brûlées dans la base locale.
# PLACARD_SMOKE_BASE_URL=http://127.0.0.1:3000
# PLACARD_SMOKE_COOKIE=nom_session=valeur_du_compte_de_recette
# PLACARD_SMOKE_CONFIRM_BURNS=LOCAL_BURNS_ONLY
# PLACARD_SMOKE_ACTION=card
# PLACARD_SMOKE_RUN_ID=
# PLACARD_SMOKE_CARD_CODE=
# PLACARD_SMOKE_BATTLE_ID=

# Audit Lighthouse mobile Placard, exclusivement sur localhost.
# PLACARD_MOBILE_AUDIT_BASE_URL=http://127.0.0.1:3000
# PLACARD_MOBILE_AUDIT_COOKIE=nom_session=valeur_du_compte_de_recette
# PLACARD_MOBILE_MIN_PERFORMANCE=0.75
# PLACARD_MOBILE_MIN_ACCESSIBILITY=0.90
# PLACARD_MOBILE_MAX_LCP_MS=4000
# PLACARD_MOBILE_MAX_CLS=0.10
# PLACARD_MOBILE_MAX_BYTES=2000000

# Audit des trois vues mobiles de l'Arène, exclusivement sur localhost.
# ARENA_MOBILE_AUDIT_BASE_URL=http://127.0.0.1:3000
# Cookie de consentement et, si besoin, session locale de recette. Le script
# obtient lui-même un cookie d'âge signé auprès du serveur local.
# ARENA_MOBILE_AUDIT_COOKIE=lcb_cookie_consent=...
# ARENA_MOBILE_MIN_PERFORMANCE=0.75
# ARENA_MOBILE_MIN_ACCESSIBILITY=0.90
# ARENA_MOBILE_MAX_LCP_MS=4000
# ARENA_MOBILE_MAX_CLS=0.10
# ARENA_MOBILE_MAX_BYTES=2000000

# Récompenses Carnet par fleur et par producteur. Laisser fermé jusqu'à ce que
# les campagnes soient configurées, vérifiées et que la migration soit appliquée.
# KQ_PRODUCER_NOTEBOOK_REWARDS_LIVE=0
